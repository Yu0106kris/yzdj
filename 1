# 第二部分：鲁棒定位求解器
# ===========================================================================

class RobustLocalizer:
    """
    基于加权鲁棒非线性最小二乘的定位求解器。

    支持多种鲁棒损失函数（linear / huber / soft_l1 / cauchy / arctan），
    以及 IRLS 迭代重加权策略。
    参考: scipy.optimize.least_squares 鲁棒损失族 [reference:3]
    """

    def __init__(self, positions: np.ndarray, distances: np.ndarray,
                 base_weights: Optional[np.ndarray] = None,
                 loss: str = "soft_l1", f_scale: float = 5.0):
        self.positions = positions      # (N, 2)
        self.distances = distances      # (N,)
        self.N = len(positions)
        self.base_weights = (base_weights if base_weights is not None
                             else np.ones(self.N))
        self.loss = loss
        self.f_scale = f_scale
        self.history: list = []

    def residuals(self, x: np.ndarray) -> np.ndarray:
        """残差 = f(r_i) - ||x - I_i||"""
        pred = np.linalg.norm(self.positions - x, axis=1)
        return self.distances - pred

    def weighted_residuals(self, x: np.ndarray,
                           weights: Optional[np.ndarray] = None) -> np.ndarray:
        w = weights if weights is not None else self.base_weights
        return np.sqrt(w) * self.residuals(x)

    def solve(self, x0: Optional[np.ndarray] = None) -> dict:
        """单次求解：加权鲁棒非线性最小二乘"""
        if x0 is None:
            x0 = np.average(self.positions, axis=0,
                            weights=self.base_weights)
        res = least_squares(
            lambda x: self.weighted_residuals(x),
            x0, loss=self.loss, f_scale=self.f_scale,
            method="trf", max_nfev=2000,
        )
        return {
            "x_hat": res.x.tolist(),
            "cost": float(res.cost),
            "optimality": float(res.optimality),
            "n_iter": int(res.nfev),
            "status": int(res.status),
        }

    def solve_irls(self, x0: Optional[np.ndarray] = None,
                   max_iter: int = 20, eps: float = 1e-6) -> dict:
        """
        IRLS 迭代重加权：每轮根据残差大小自适应更新权重。
        权重函数 w_i = 1 / (|e_i|^2 + eps^2)
        参考: IRLS for squared range localization [reference:4]
        """
        if x0 is None:
            x0 = np.average(self.positions, axis=0,
                            weights=self.base_weights)
        x = x0.copy()
        weights = self.base_weights.copy()
        cost_history = []

        for k in range(max_iter):
            res = least_squares(
                lambda x: np.sqrt(weights) * self.residuals(x),
                x, loss="linear", max_nfev=500,
            )
            x = res.x
            e = self.residuals(x)
            cost_history.append(float(np.sum(weights * e ** 2)))

            # 自适应权重重分配
            new_w = 1.0 / (e ** 2 + eps)
            new_w = new_w / np.mean(new_w)
            delta = np.max(np.abs(new_w - weights))
            weights = new_w

            if delta < 1e-5 and k > 3:
                break

        return {
            "x_hat": x.tolist(),
            "weights_final": weights.tolist(),
            "cost_history": cost_history,
            "n_iter": k + 1,
        }


