def run_agent(args: argparse.Namespace) -> None:
    root = Path(args.out).resolve()
    root.mkdir(parents=True, exist_ok=True)

    use_llm = (not args.mock) and (OpenAI is not None) and bool(DEFAULT_API_KEY)
    if not args.mock and not use_llm:
        print("[info] 未检测到 API Key，使用规则引擎模式。")

    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    run_dir = root / "runs" / f"run_{stamp}"
    run_dir.mkdir(parents=True, exist_ok=True)
    trace_path = run_dir / "trace.jsonl"

    print("=" * 65)
    print("  hw-problem1-localization-agent")
    print("  华为难题一：众包离线高精度位置聚合")
    print("=" * 65)
    print(f"迭代轮次：{args.iterations}")
    print(f"运行目录：{run_dir}")
    print(f"LLM 润色：{'启用' if use_llm else '关闭'}")
    print("-" * 65)

    # 构建基准数据集
    datasets = build_benchmark(n_scenes=args.scenes)
    print(f"[data] 构建 {len(datasets)} 个基准场景")
    print("-" * 65)

    state = ResearchState()
    planner = Planner()
    records: list = []

    for _ in range(args.iterations):
        action = planner.plan(state)
        result = planner.execute(action, state, datasets)
        verification = verify(action, result)
        reflection = reflect(action, result, verification, state, use_llm)
        apply_result(state, action, result)

        record = {
            "iteration": state.iteration,
            "timestamp": datetime.now().isoformat(timespec="seconds"),
            "action": asdict(action),
            "result": result,
            "verification": verification,
            "reflection": reflection,
            "state_snapshot": {
                "best_cep90": round(state.best_cep90, 4),
                "best_config": state.best_config,
                "irls_improvement": state.irls_improvement,
                "hypothesis_count": len(state.hypotheses),
                "obstacle_count": len(state.obstacles),
            },
        }
        records.append(record)
        with trace_path.open("a", encoding="utf-8") as f:
            f.write(json.dumps(record, ensure_ascii=False) + "\n")

        # 终端简报
        brief = ""
        if "cep90" in result:
            brief = f"CEP90={result['cep90']:.2f}m"
        elif result["kind"] == "irls":
            brief = f"改进={result['improvement_pct']}%"
        elif result["kind"] == "converge":
            brief = f"spread={result['spread']:.2f}m"
        elif result["kind"] == "scenario":
            brief = " | ".join(f"{k}={v['cep90']:.1f}m"
                               for k, v in result["comparison"].items())
        print(f"[{state.iteration:>3}] {action.kind:<18} | "
              f"{verification['status']:<8} | {brief}")

    # 保存最终状态
    state_dict = asdict(state)
    state_dict["phases_done"] = list(state.phases_done)
    (run_dir / "state.json").write_text(
        json.dumps(state_dict, ensure_ascii=False, indent=2),
        encoding="utf-8")

    # 生成报告
