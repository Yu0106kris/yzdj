def compile_pdf(tex_path: Path, out_dir: Path) -> Optional[Path]:
    engine = None
    for cand in ("xelatex", "pdflatex"):
        if shutil.which(cand):
            engine = cand
            break
    if engine is None:
        print("[warn] 未检测到 LaTeX 引擎，跳过 PDF 编译。")
        return None
    for _ in range(2):
        try:
            subprocess.run(
                [engine, "-interaction=nonstopmode",
                 f"-output-directory={out_dir}", str(tex_path)],
                check=True, capture_output=True, timeout=180)
        except subprocess.CalledProcessError as e:
            print(f"[warn] {engine} 编译失败：")
            print(e.stdout.decode(errors="ignore")[-1200:])
            return None
    pdf = out_dir / (tex_path.stem + ".pdf")
    for ext in (".aux", ".log", ".out", ".toc"):
        f = out_dir / (tex_path.stem + ext)
        if f.exists():
            f.unlink()
    return pdf if pdf.exists() else None


