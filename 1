@dataclass
class Action:
    kind: str
    params: dict
    rationale: str


@dataclass
class ResearchState:
    iteration: int = 0
    best_cep90: float = float("inf")
    best_config: dict = field(default_factory=dict)
    loss_results: dict = field(default_factory=dict)   # loss -> cep90
    fscale_results: dict = field(default_factory=dict)
    irls_improvement: float = 0.0
    scenario_comparison: dict = field(default_factory=dict)
    hypotheses: list = field(default_factory=list)
    obstacles: list = field(default_factory=list)
    phases_done: set = field(default_factory=set)


class Planner:
    """
    状态驱动的规划器：
    Phase 1 (iter 1-8)   : 扫描鲁棒损失函数类型
    Phase 2 (iter 9-16)  : 扫描 f_scale 参数
    Phase 3 (iter 17-24) : IRLS 迭代重加权优化
    Phase 4 (iter 25+)   : 场景对比与收敛验证
    """

    LOSSES = ["linear", "huber", "soft_l1", "cauchy", "arctan"]
    FSCALES = [1.0, 3.0, 5.0, 8.0, 12.0, 20.0]

    def plan(self, state: ResearchState) -> Action:
        it = state.iteration

        if it < len(self.LOSSES):
            loss = self.LOSSES[it]
            return Action("sweep_loss", {"loss": loss},
                          f"扫描鲁棒损失函数 '{loss}'，评估其对离群点的抑制效果。")

        if it < len(self.LOSSES) + len(self.FSCALES):
            idx = it - len(self.LOSSES)
            fs = self.FSCALES[idx]
            best_loss = state.best_config.get("loss", "soft_l1")
            return Action("sweep_fscale", {"loss": best_loss, "f_scale": fs},
                          f"固定最优损失 '{best_loss}'，扫描 f_scale={fs}。")

        if it < len(self.LOSSES) + len(self.FSCALES) + 6:
            return Action("irls", {},
                          "执行 IRLS 迭代重加权，验证自适应权重是否优于固定权重。")

        if it < len(self.LOSSES) + len(self.FSCALES) + 12:
            return Action("scenario", {},
                          "对比静止与移动场景下的最优策略差异。")

        return Action("converge", {},
                      "检查最优解稳定性，尝试多初值验证是否收敛到全局最优。")

    def execute(self, action: Action, state: ResearchState,
                datasets: list) -> dict:
        if action.kind == "sweep_loss":
            return self._sweep_loss(action.params["loss"], datasets)
        if action.kind == "sweep_fscale":
            return self._sweep_fscale(action.params["loss"],
                                      action.params["f_scale"], datasets)
        if action.kind == "irls":
            return self._run_irls(datasets)
        if action.kind == "scenario":
            return self._scenario_compare(datasets)
        if action.kind == "converge":
            return self._converge_check(datasets)
        raise ValueError(f"未知动作: {action.kind}")

    def _sweep_loss(self, loss: str, datasets: list) -> dict:
        ests, truths = [], []
        for ds in datasets:
            loc = RobustLocalizer(ds.positions, ds.distances,
                                  loss=loss, f_scale=5.0)
            r = loc.solve()
            ests.append(r["x_hat"])
            truths.append(ds.true_pos)
        ests = np.array(ests)
        truths = np.array(truths)
        cep = compute_cep90(ests, truths)
        rmse = compute_rmse(ests, truths)
        return {"kind": "sweep_loss", "loss": loss,
                "cep90": round(cep, 4), "rmse": round(rmse, 4)}

    def _sweep_fscale(self, loss: str, f_scale: float,
                      datasets: list) -> dict:
        ests, truths = [], []
        for ds in datasets:
            loc = RobustLocalizer(ds.positions, ds.distances,
                                  loss=loss, f_scale=f_scale)
            r = loc.solve()
            ests.append(r["x_hat"])
            truths.append(ds.true_pos)
        ests = np.array(ests)
        truths = np.array(truths)
        cep = compute_cep90(ests, truths)
        rmse = compute_rmse(ests, truths)
        return {"kind": "sweep_fscale", "loss": loss, "f_scale": f_scale,
                "cep90": round(cep, 4), "rmse": round(rmse, 4)}

    def _run_irls(self, datasets: list) -> dict:
        ests_irls, ests_std, truths = [], [], []
        for ds in datasets:
            loc = RobustLocalizer(ds.positions, ds.distances,
                                  loss="soft_l1", f_scale=5.0)
            r_std = loc.solve()
            r_irls = loc.solve_irls()
            ests_std.append(r_std["x_hat"])
            ests_irls.append(r_irls["x_hat"])
            truths.append(ds.true_pos)
        ests_std = np.array(ests_std)
        ests_irls = np.array(ests_irls)
        truths = np.array(truths)
        cep_std = compute_cep90(ests_std, truths)
        cep_irls = compute_cep90(ests_irls, truths)
        improvement = (cep_std - cep_irls) / max(cep_std, 1e-6) * 100
        return {"kind": "irls", "cep90_std": round(cep_std, 4),
                "cep90_irls": round(cep_irls, 4),
                "improvement_pct": round(improvement, 2)}

    def _scenario_compare(self, datasets: list) -> dict:
        result = {}
        for scenario in ["static", "moving"]:
            sub = [ds for ds in datasets if ds.scenario == scenario]
            if not sub:
                continue
            ests, truths = [], []
            for ds in sub:
                loc = RobustLocalizer(ds.positions, ds.distances,
                                      loss="soft_l1", f_scale=5.0)
                r = loc.solve()
                ests.append(r["x_hat"])
                truths.append(ds.true_pos)
            cep = compute_cep90(np.array(ests), np.array(truths))
            result[scenario] = {"n_scenes": len(sub),
                                "cep90": round(cep, 4)}
        return {"kind": "scenario", "comparison": result}

    def _converge_check(self, datasets: list) -> dict:
        """多初值验证：从不同初值出发，检查最优解是否稳定"""
        ds = datasets[0]
        loc = RobustLocalizer(ds.positions, ds.distances,
                              loss="soft_l1", f_scale=5.0)
        starts = [
            np.average(ds.positions, axis=0),
            ds.positions[0],
            np.array([0.0, 0.0]),
            np.array([50.0, 50.0]),
            np.array([-50.0, -50.0]),
        ]
        results = []
        for x0 in starts:
            r = loc.solve(x0=x0)
            err = np.linalg.norm(np.array(r["x_hat"]) - ds.true_pos)
            results.append({"x0": x0.tolist(),
                            "x_hat": r["x_hat"],
                            "error": round(err, 4)})
        errors = [r["error"] for r in results]
        spread = max(errors) - min(errors)
        return {"kind": "converge", "n_starts": len(starts),
                "errors": [round(e, 4) for e in errors],
                "spread": round(spread, 4),
                "stable": spread < 10.0}


