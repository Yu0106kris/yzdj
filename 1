def rebuild_report(args: argparse.Namespace) -> None:
    root = Path(args.out).resolve()
    runs_dir = root / "runs"
    if not runs_dir.exists():
        print("未找到 runs/ 目录")
        return
    candidates = sorted([p for p in runs_dir.iterdir() if p.is_dir()])
    if not candidates:
        print("runs/ 下没有运行记录")
        return
    last = candidates[-1]
    print(f"从 {last} 重建报告")

    records = []
    with (last / "trace.jsonl").open(encoding="utf-8") as f:
        for line in f:
            if line.strip():
                records.append(json.loads(line))

    state = ResearchState()
    for rec in records:
        state.iteration = rec["iteration"]
        r = rec["result"]
        if r["kind"] == "sweep_loss":
            state.loss_results[r["loss"]] = r["cep90"]
            if r["cep90"] < state.best_cep90:
                state.best_cep90 = r["cep90"]
                state.best_config = {"loss": r["loss"], "f_scale": 5.0}
        elif r["kind"] == "sweep_fscale":
            key = f"{r['loss']}_{r['f_scale']}"
            state.fscale_results[key] = r["cep90"]
            if r["cep90"] < state.best_cep90:
                state.best_cep90 = r["cep90"]
                state.best_config = {"loss": r["loss"], "f_scale": r["f_scale"]}
        elif r["kind"] == "irls":
            state.irls_improvement = r["improvement_pct"]
        elif r["kind"] == "scenario":
            state.scenario_comparison = r["comparison"]
        snap = rec["state_snapshot"]
        state.hypotheses = [""] * snap.get("hypothesis_count", 0)
        state.obstacles = [""] * snap.get("obstacle_count", 0)

    reports_dir = root / "reports"
    reports_dir.mkdir(parents=True, exist_ok=True)
    (reports_dir / "final_report.md").write_text(
        build_markdown_report(state, records), encoding="utf-8")
    tex_path = reports_dir / "final_report.tex"
    tex_path.write_text(build_latex(state, records), encoding="utf-8")
    pdf = compile_pdf(tex_path, reports_dir)
    print(f"✅ 报告重建完成，PDF：{pdf}")


