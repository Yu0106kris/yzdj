@dataclass
class ExperimentDataset:
    """一组众包定位数据"""
    name: str
    positions: np.ndarray       # (N, 2) 好心人位置
    rssi: np.ndarray            # (N,) RSSI 值
    distances: np.ndarray       # (N,) 由 RSSI 推算的距离
    true_pos: np.ndarray        # (2,) 真值
    n_good: int
    n_outlier: int
    scenario: str               # "static" | "moving"


def generate_dataset(
    true_pos: np.ndarray,
    n_good: int = 12,
    n_outlier: int = 3,
    scenario: str = "static",
    rssi_noise_std: float = 4.0,
    outlier_bias: float = 25.0,
    tx_power: float = -59.0,
    n_path_loss: float = 2.5,
) -> ExperimentDataset:
    """
    生成一组模拟数据：
    - 好心人在真值附近随机分布
    - RSSI 服从对数路径损耗模型 + 高斯噪声
    - 离群点：RSSI 被大幅偏置，模拟 GNSS/WiFi 定位误差
    """
    # 好心人位置：以真值为中心，半径 5~35 米随机分布
    angles = RNG.uniform(0, 2 * np.pi, n_good)
    radii = RNG.uniform(5, 35, n_good)
    good_pos = true_pos + np.column_stack([radii * np.cos(angles),
                                            radii * np.sin(angles)])

    # 真实距离与 RSSI
    true_dists = np.linalg.norm(good_pos - true_pos, axis=1)
    rssi_clean = tx_power - 10 * n_path_loss * np.log10(np.clip(true_dists, 0.1, None))
    rssi = rssi_clean + RNG.normal(0, rssi_noise_std, n_good)

    # 离群点：位置合理但 RSSI 被偏置（模拟定位误差）
    if n_outlier > 0:
        angles_o = RNG.uniform(0, 2 * np.pi, n_outlier)
        radii_o = RNG.uniform(10, 40, n_outlier)
        out_pos = true_pos + np.column_stack([radii_o * np.cos(angles_o),
                                               radii_o * np.sin(angles_o)])
        rssi_out = rssi_clean.mean() + RNG.normal(
            outlier_bias, rssi_noise_std * 2, n_outlier)
        all_pos = np.vstack([good_pos, out_pos])
        all_rssi = np.concatenate([rssi, rssi_out])
    else:
        all_pos = good_pos
        all_rssi = rssi

    dists = rssi_to_distance(all_rssi, tx_power, n_path_loss)

    # 移动场景：在位置和 RSSI 上施加额外扰动
    if scenario == "moving":
        all_pos = all_pos + RNG.normal(0, 8.0, all_pos.shape)
        all_rssi = all_rssi + RNG.normal(0, 3.0, len(all_rssi))
        dists = rssi_to_distance(all_rssi, tx_power, n_path_loss)

    return ExperimentDataset(
        name=f"{scenario}_good{n_good}_out{n_outlier}",
        positions=all_pos, rssi=all_rssi, distances=dists,
        true_pos=true_pos, n_good=n_good, n_outlier=n_outlier,
        scenario=scenario,
    )


def build_benchmark(n_scenes: int = 20) -> list:
    """构建基准测试集：多种场景组合"""
    datasets = []
    for i in range(n_scenes):
        true_pos = RNG.uniform(-50, 50, 2)
        scenario = "moving" if i % 2 == 0 else "static"
        n_good = RNG.integers(8, 20)
        n_out = RNG.integers(0, 5)
        ds = generate_dataset(
            true_pos, n_good=int(n_good), n_outlier=int(n_out),
            scenario=scenario,
            outlier_bias=RNG.uniform(15, 35),
        )
        datasets.append(ds)
    return datasets


