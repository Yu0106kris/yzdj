def rssi_to_distance(rssi_dbm: np.ndarray, tx_power: float = -59.0,
                     n_path_loss: float = 2.5) -> np.ndarray:
    """
    对数路径损耗模型：RSSI = tx_power - 10 * n * log10(d)
    反解距离 d = 10^((tx_power - RSSI) / (10 * n))

    参考: RSSI = -10n*log10(d/d0) + C [reference:2]
    """
    rssi_clipped = np.clip(rssi_dbm, -100.0, -20.0)
    d = 10.0 ** ((tx_power - rssi_clipped) / (10.0 * n_path_loss))
    return np.clip(d, 0.1, 200.0)


def compute_cep90(estimated: np.ndarray, ground_truth: np.ndarray,
                  n_samples: int = 1000) -> float:
    """
    CEP90: 90% 分位圆概率误差。
    对多组估计与真值对，计算距离误差的 90% 分位数。
    """
    if estimated.ndim == 1:
        estimated = estimated.reshape(1, -1)
    if ground_truth.ndim == 1:
        ground_truth = ground_truth.reshape(1, -1)
    errors = np.linalg.norm(estimated - ground_truth, axis=1)
    return float(np.percentile(errors, 90))


def compute_rmse(estimated: np.ndarray, ground_truth: np.ndarray) -> float:
    if estimated.ndim == 1:
        estimated = estimated.reshape(1, -1)
    if ground_truth.ndim == 1:
        ground_truth = ground_truth.reshape(1, -1)
    errors = np.linalg.norm(estimated - ground_truth, axis=1)
    return float(np.sqrt(np.mean(errors ** 2)))


