def verify(action: Action, result: dict) -> dict:
    checks = []
    if result["kind"] == "sweep_loss":
        checks.append({"name": "损失函数评估", "passed": result["cep90"] < 100,
                       "detail": f"CEP90 = {result['cep90']} m"})
    elif result["kind"] == "sweep_fscale":
        checks.append({"name": "f_scale 评估", "passed": result["cep90"] < 100,
                       "detail": f"CEP90 = {result['cep90']} m"})
    elif result["kind"] == "irls":
        checks.append({"name": "IRLS 改进验证",
                       "passed": result["improvement_pct"] > 0,
                       "detail": f"改进 = {result['improvement_pct']}%"})
    elif result["kind"] == "converge":
        checks.append({"name": "收敛稳定性", "passed": result["stable"],
                       "detail": f"spread = {result['spread']} m"})
    else:
        checks.append({"name": "场景对比", "passed": True, "detail": "OK"})
    all_passed = all(c["passed"] for c in checks)
    return {"status": "passed" if all_passed else "warning",
            "checks": checks}


def reflect(action: Action, result: dict, verification: dict,
            state: ResearchState, use_llm: bool) -> str:
    if result["kind"] == "sweep_loss":
        base = (f"损失 '{result['loss']}'：CEP90 = {result['cep90']} m，"
                f"RMSE = {result['rmse']} m。")
        if result["cep90"] < 30:
            base += " 已满足 CEP90 ≤ 30 m 的目标。"
        else:
            base += " 距离 CEP90 ≤ 30 m 目标仍有差距。"
    elif result["kind"] == "sweep_fscale":
        base = (f"损失='{result['loss']}', f_scale={result['f_scale']}："
                f"CEP90 = {result['cep90']} m。")
    elif result["kind"] == "irls":
        base = (f"IRLS 迭代重加权：固定权重 CEP90 = {result['cep90_std']} m，"
                f"IRLS CEP90 = {result['cep90_irls']} m，"
                f"改进 {result['improvement_pct']}%。")
    elif result["kind"] == "scenario":
        comp = result["comparison"]
        base = "场景对比：" + "；".join(
            f"{k} 场景 {v['n_scenes']} 个，CEP90={v['cep90']} m"
            for k, v in comp.items())
    elif result["kind"] == "converge":
        base = (f"多初值验证：{result['n_starts']} 个初值，"
                f"误差范围 [{min(result['errors'])}, {max(result['errors'])}]，"
                f"spread={result['spread']} m，"
                f"{'稳定' if result['stable'] else '不稳定'}。")
    else:
        base = "本轮无输出。"

    if not verification["status"] == "passed":
        base += " ⚠ 验证未全部通过。"

    if use_llm and OpenAI is not None:
        text = llm_generate(
            system="你是定位算法研究智能体的反思模块，用2-3句中文总结本轮发现与下一步建议。",
            user=json.dumps({"action": asdict(action),
                             "result": result,
                             "verification": verification},
                            ensure_ascii=False))
        if text:
            return text
    return base


def apply_result(state: ResearchState, action: Action, result: dict) -> None:
    state.iteration += 1
    if result["kind"] == "sweep_loss":
        state.loss_results[result["loss"]] = result["cep90"]
        if result["cep90"] < state.best_cep90:
            state.best_cep90 = result["cep90"]
            state.best_config = {"loss": result["loss"],
                                 "f_scale": state.best_config.get("f_scale", 5.0)}
    elif result["kind"] == "sweep_fscale":
        key = f"{result['loss']}_{result['f_scale']}"
        state.fscale_results[key] = result["cep90"]
        if result["cep90"] < state.best_cep90:
            state.best_cep90 = result["cep90"]
            state.best_config = {"loss": result["loss"],
                                 "f_scale": result["f_scale"]}
    elif result["kind"] == "irls":
        state.irls_improvement = result["improvement_pct"]
        if result["improvement_pct"] > 5:
            state.hypotheses.append(
                f"IRLS 迭代重加权相比固定权重在 CEP90 上改进 "
                f"{result['improvement_pct']}%")
    elif result["kind"] == "scenario":
        state.scenario_comparison = result["comparison"]
        for sc, v in result["comparison"].items():
            if v["cep90"] > 30:
                state.obstacles.append(
                    f"{sc} 场景 CEP90={v['cep90']} m，尚未达到 30 m 目标")
    elif result["kind"] == "converge":
        if not result["stable"]:
            state.obstacles.append(
                f"多初值求解不稳定，spread={result['spread']} m")


